# =====================================================================
# ICMS · Variables para EJECUCIÓN EN DOCKER (dev y prod)
# Los compose ya definen los hostnames de la red interna
# (postgres-primary, redis, rabbitmq, minio). Este archivo es para
# SOBRESCRIBIR SECRETOS en producción:  docker compose --env-file .env.docker ...
# =====================================================================

# --- Seguridad (¡cámbialo en producción!) ---
JWT_SECRET=cambia-esto-por-un-secreto-fuerte
# Sesión de 30 minutos renovable (RF-SES-002) — NO alargar en producción.
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=30m
JWT_ISSUER=icms-platform

# --- Observabilidad ---
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=icms
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=icms
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=cambia-esta-contrasena

# --- RabbitMQ ---
RABBITMQ_USER=icms
RABBITMQ_PASSWORD=cambia-esta-contrasena

# --- MinIO / S3 ---
S3_ACCESS_KEY=icmsminio
S3_SECRET_KEY=cambia-esta-contrasena
S3_BUCKET=icms-files
