# =====================================================================
# Imagen de DESARROLLO (compartida por los 10 servicios)
# Las dependencias se hornean en la imagen (compiladas para Linux); el
# código fuente se monta como volumen para hot-reload con `nx serve`.
# =====================================================================
FROM node:22-bookworm-slim

# pnpm vía corepack (misma versión declarada en package.json / lockfile)
RUN corepack enable

WORKDIR /workspace

# Solo los manifiestos: maximiza la caché de capas. `pnpm install` se rehace
# únicamente cuando cambian package.json o el lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# El código real llega por bind-mount en docker-compose.dev.yml.
# El comando concreto (nx serve <servicio>) lo define cada servicio en compose.
EXPOSE 3000-3009
CMD ["pnpm", "exec", "nx", "run-many", "-t", "serve"]
