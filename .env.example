# =====================================================================
# ICMS Platform - variables de entorno de ejemplo
# Copia este archivo a `.env` y ajusta los valores.
# =====================================================================

NODE_ENV=development

# ---------------------------------------------------------------------
# Puertos de los servicios (el gateway es el único público)
# ---------------------------------------------------------------------
GATEWAY_PORT=3000
AUTH_PORT=3001
CONFIGURATION_PORT=3002
CORE_DOMAIN_PORT=3003
REPORTING_PORT=3004
NOTIFICATION_PORT=3005
INTEGRATION_PORT=3006
FILE_PORT=3007
SCHEDULER_PORT=3008
REALTIME_PORT=3009

# URLs internas usadas por el gateway para enrutar (docker network o localhost)
AUTH_SERVICE_URL=http://localhost:3001
CONFIGURATION_SERVICE_URL=http://localhost:3002
CORE_DOMAIN_SERVICE_URL=http://localhost:3003
REPORTING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
INTEGRATION_SERVICE_URL=http://localhost:3006
FILE_SERVICE_URL=http://localhost:3007
REALTIME_SERVICE_URL=http://localhost:3009

# ---------------------------------------------------------------------
# JWT (compartido para validación preliminar en gateway y validación
# completa en cada servicio). En producción usa claves asimétricas.
# ---------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
JWT_ISSUER=icms-platform

# JWKS: URL de las claves públicas de auth-service. Si se define, TODOS los
# servicios (y el gateway) validan access tokens RS256 vía JWKS. Si se omite,
# se usa HS256 con JWT_SECRET (solo desarrollo).
JWKS_URI=http://localhost:3001/.well-known/jwks.json
# En producción, provee el par RSA en PEM (con \n escapados) en auth-service:
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------
# PostgreSQL (primary de escritura + réplica de lectura)
# database-per-service: usa DB distinta por servicio (POSTGRES_DB_*)
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_REPLICA_HOST=localhost
POSTGRES_REPLICA_PORT=5433
POSTGRES_USER=icms
POSTGRES_PASSWORD=icms
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator
POSTGRES_DB=icms

# ---------------------------------------------------------------------
# Redis (rate limiting, locks distribuidos, adaptador de websockets)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------
# RabbitMQ (eventos de dominio, colas de salida, reintentos)
# ---------------------------------------------------------------------
RABBITMQ_URL=amqp://icms:icms@localhost:5672
RABBITMQ_EXCHANGE=icms.events
RABBITMQ_USER=icms
RABBITMQ_PASSWORD=icms

# ---------------------------------------------------------------------
# MinIO / Object storage (S3 compatible) - usado por file-service
# ---------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=icmsminio
S3_SECRET_KEY=icmsminio123
S3_BUCKET=icms-files
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------
# Rate limiting (gateway)
# ---------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------
LOG_LEVEL=info
METRICS_ENABLED=true

# ---------------------------------------------------------------------
# Notification providers (stubs)
# ---------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@icms.local
