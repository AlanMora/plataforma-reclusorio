{
  "uid": "trazabilidad-reclusorio",
  "title": "Trazabilidad",
  "tags": [
    "reclusorio",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "stream": "{stack=\"reclusorio\"}",
          "type": 1
        },
        "definition": "label_values({stack=\"reclusorio\"}, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "usuario",
        "label": "Usuario",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "correlacion",
        "label": "Correlation ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "ruta",
        "label": "Ruta contiene",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Peticiones por servicio",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (count_over_time({stack=\"reclusorio\", service=~\"$servicio\"} |= \"request completed\" | json | username=~\"(?i).*$usuario.*\" | correlationId=~\".*$correlacion.*\" | req_url=~\".*$ruta.*\" [$__auto]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errores (nivel error/fatal y respuestas 5xx)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (count_over_time({stack=\"reclusorio\", service=~\"$servicio\", level=~\"error|fatal\"} [$__auto]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Peticiones por usuario (rango seleccionado)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{username}}",
          "expr": "sort_desc(sum by (username) (count_over_time({stack=\"reclusorio\", service=~\"$servicio\"} |= \"request completed\" | json | username!=\"\" [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Escrituras por usuario (POST/PUT/PATCH/DELETE)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{username}} {{req_method}}",
          "expr": "sort_desc(sum by (username, req_method) (count_over_time({stack=\"reclusorio\", service=~\"$servicio\"} |= \"request completed\" | json | req_method=~\"POST|PUT|PATCH|DELETE\" | username!=\"\" [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs (filtra por servicio, usuario, correlation ID o ruta)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{stack=\"reclusorio\", service=~\"$servicio\"} | json | username=~\"(?i).*$usuario.*\" | correlationId=~\".*$correlacion.*\" | req_url=~\".*$ruta.*\""
        }
      ]
    }
  ]
}